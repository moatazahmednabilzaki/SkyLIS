# Sky LIS on-premises configuration — copy to .env and fill EVERY value.
# The .env file holds secrets: keep it out of version control and readable
# by the deployment account only.

# PostgreSQL password for the skylis application role (generate a long random value)
SKYLIS_DB_PASSWORD=

# JWT signing key — at least 32 random characters. Generate with:
#   openssl rand -base64 48        (Linux)
#   [Convert]::ToBase64String((1..48 | %% { Get-Random -Max 256 }))   (PowerShell)
AUTH_SIGNING_KEY=

# First platform operator (Admin Portal). Created ONCE on an empty install;
# change the password from the portal afterwards and clear these lines.
PLATFORM_ADMIN_USERNAME=platform.admin
PLATFORM_ADMIN_FULLNAME=Platform Administrator
PLATFORM_ADMIN_PASSWORD=

# Release version — tags the built images (skylis/api:<version> etc.) so a deploy
# is immutable and can be rolled back. Bump this when you deploy a new release.
SKYLIS_VERSION=2026.08.1

# Docker network subnet for the stack. The API trusts X-Forwarded-For only from this
# range, so it records real client IPs (rate limiter, audit trail) behind the proxy.
# Change only if it collides with an existing network on the host.
SKYLIS_NET_SUBNET=172.28.0.0/16

# Host ports
CLIENT_PORTAL_PORT=8080
ADMIN_PORTAL_PORT=8081

# Session lifetimes
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_HOURS=12
